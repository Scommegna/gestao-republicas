<nav class="navbar navbar-expand-lg app-navbar sticky-top">
  <div class="container">
    <%= link_to authenticated_root_path, class: "navbar-brand" do %>
      <span class="brand-mark"><i class="bi bi-house-heart-fill" aria-hidden="true"></i></span>
      Gestão de Repúblicas
    <% end %>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
            data-bs-target="#mainNav" aria-controls="mainNav"
            aria-expanded="false" aria-label="Abrir menu">
      <i class="bi bi-list fs-3" aria-hidden="true"></i>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to authenticated_root_path, class: "nav-link #{'active' if current_page?(authenticated_root_path) || current_page?(dashboard_path)}" do %>
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>Painel
          <% end %>
        </li>
        <li class="nav-item">
          <%= link_to republicas_path, class: "nav-link #{'active' if controller_name == 'republicas'}" do %>
            <i class="bi bi-houses" aria-hidden="true"></i>Repúblicas
          <% end %>
        </li>
      </ul>

      <div class="d-flex align-items-center gap-1">
        <%= link_to "#", class: "icon-btn", title: "Configurações", aria: { label: "Configurações" } do %>
          <i class="bi bi-gear" aria-hidden="true"></i>
        <% end %>

        <div class="dropdown">
          <button class="btn p-0 border-0 d-flex align-items-center gap-2" type="button"
                  data-bs-toggle="dropdown" aria-expanded="false" title="Perfil">
            <span class="avatar"><%= current_user.first_name.to_s.first&.upcase %><%= current_user.last_name.to_s.first&.upcase %></span>
            <span class="d-none d-lg-inline small fw-semibold text-dark"><%= current_user.first_name %></span>
            <i class="bi bi-chevron-down small text-muted d-none d-lg-inline" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
            <li class="px-3 py-2">
              <div class="fw-semibold small"><%= current_user.first_name %> <%= current_user.last_name %></div>
              <div class="text-muted small"><%= current_user.email %></div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to edit_user_registration_path, class: "dropdown-item" do %>
              <i class="bi bi-person me-2" aria-hidden="true"></i>Perfil
            <% end %></li>
            <li><%= link_to "#", class: "dropdown-item" do %>
              <i class="bi bi-gear me-2" aria-hidden="true"></i>Configurações
            <% end %></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <%= button_to destroy_user_session_path, method: :delete,
                    class: "dropdown-item text-danger" do %>
                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sair
              <% end %>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>

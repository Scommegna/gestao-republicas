<% content_for :title, "Dashboard administrativo" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <p class="text-muted small mb-1">Painel da república</p>
      <h1 class="h3 mb-1">Resumo financeiro</h1>
      <div class="d-flex align-items-center gap-2">
        <span class="h5 mb-0"><%= @republica.name %></span>
        <%= tipo_badge(@republica) %>
        <% unless @is_owner %>
          <span class="badge text-bg-info"><i class="bi bi-person-check me-1" aria-hidden="true"></i>Você participa</span>
        <% end %>
      </div>
    </div>

    <% if @republicas.size > 1 %>
      <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>Trocar república
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <% @republicas.each do |rep| %>
            <li>
              <%= link_to dashboard_path(republica_id: rep.id),
                    class: "dropdown-item #{'active' if rep.id == @republica.id}" do %>
                <%= rep.name %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <% if @despesas.none? && @active_residents_count.zero? %>
    <div class="alert alert-info">
      Nenhum dado financeiro cadastrado ainda. Use os atalhos para registrar moradores e despesas.
    </div>
  <% end %>

  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 text-muted mb-0">Despesas do mês</h2>
            <i class="bi bi-calendar3 text-success" aria-hidden="true"></i>
          </div>
          <p class="h4 mb-0"><%= number_to_currency(@current_month_expenses_total) %></p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 text-muted mb-0">Total cadastrado</h2>
            <i class="bi bi-cash-stack text-primary" aria-hidden="true"></i>
          </div>
          <p class="h4 mb-0"><%= number_to_currency(@registered_expenses_total) %></p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 text-muted mb-0">Moradores ativos</h2>
            <i class="bi bi-people text-info" aria-hidden="true"></i>
          </div>
          <p class="h4 mb-0"><%= @active_residents_count %></p>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h2 class="h6 text-muted mb-0">Pagamentos</h2>
            <i class="bi bi-receipt text-warning" aria-hidden="true"></i>
          </div>
          <p class="mb-1"><span class="fw-semibold"><%= number_to_currency(@pending_payments_total) %></span> pendente</p>
          <p class="mb-0"><span class="fw-semibold"><%= number_to_currency(@paid_payments_total) %></span> pago</p>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-12 col-lg-4">
      <% if @is_owner %>
        <h2 class="h5 mb-3">Atalhos</h2>
        <div class="d-grid gap-2 mb-4">
          <%= link_to new_republica_despesa_path(@primary_republica), class: "btn btn-success text-start" do %>
            <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
            Registrar despesa
          <% end %>
          <%= link_to new_republica_resident_path(@primary_republica), class: "btn btn-primary text-start" do %>
            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>
            Registrar morador
          <% end %>
          <%= link_to republica_pagamentos_path(@primary_republica), class: "btn btn-outline-primary text-start" do %>
            <i class="bi bi-check2-square me-1" aria-hidden="true"></i>
            Registrar pagamento
          <% end %>
          <%= link_to republica_path(@primary_republica), class: "btn btn-outline-secondary text-start" do %>
            <i class="bi bi-gear me-1" aria-hidden="true"></i>
            Gerenciar república
          <% end %>
        </div>
      <% end %>

      <div class="card mb-4">
        <div class="card-header bg-transparent d-flex align-items-center justify-content-between">
          <h2 class="h6 mb-0"><i class="bi bi-people me-2" aria-hidden="true"></i>Participantes</h2>
          <span class="badge text-bg-light"><%= @residents.size %></span>
        </div>
        <ul class="list-group list-group-flush">
          <% if @residents.any? %>
            <% @residents.each do |resident| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                  <%= resident.name %>
                  <% if resident.user_id == current_user.id %>
                    <span class="badge text-bg-secondary ms-1">você</span>
                  <% end %>
                </span>
                <span class="text-muted small">Deve <%= number_to_currency(@total_por_morador[resident.id] || 0) %></span>
              </li>
            <% end %>
          <% else %>
            <li class="list-group-item text-muted">Nenhum morador ativo ainda.</li>
          <% end %>
        </ul>
      </div>

      <div class="card">
        <div class="card-header bg-transparent">
          <h2 class="h6 mb-0"><i class="bi bi-megaphone me-2" aria-hidden="true"></i>Avisos</h2>
        </div>
        <div class="card-body text-muted small">
          Nenhum aviso no momento. Em breve você poderá publicar avisos para a república.
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-8">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <h2 class="h5 mb-0">Contas recentes</h2>
        <%= link_to "Ver todas as despesas", republica_despesas_path(@republica), class: "link-secondary" %>
      </div>

      <% if @recent_expenses.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Descrição</th>
                <th>Vencimento</th>
                <th class="text-end">Valor</th>
                <th class="text-end">Por morador</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_expenses.each do |despesa| %>
                <tr>
                  <td><%= link_to despesa.descricao, republica_despesa_path(@republica, despesa), class: "link-dark" %></td>
                  <td><%= despesa.vencimento.strftime("%d/%m/%Y") %></td>
                  <td class="text-end"><%= number_to_currency(despesa.valor) %></td>
                  <td class="text-end">
                    <% if despesa.valor_por_morador %>
                      <%= number_to_currency(despesa.valor_por_morador) %>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="alert alert-light border mb-0">Nenhuma despesa cadastrada para exibir.</div>
      <% end %>
    </div>
  </div>
</div>

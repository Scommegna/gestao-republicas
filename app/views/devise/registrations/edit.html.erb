<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light border-0 pt-4 pb-3">
          <h2 class="mb-0 h4"><%= resource_name.to_s.humanize %></h2>
          <p class="text-muted small mb-0">Atualize suas informações de conta</p>
        </div>
        <div class="card-body pt-4">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "needs-validation" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "seu@email.com" %>
              <small class="text-muted">Seu endereço de email para login</small>
            </div>

            <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
              <div class="alert alert-info small mb-3">
                <i class="bi bi-info-circle me-2" aria-hidden="true"></i>
                Aguardando confirmação para: <strong><%= resource.unconfirmed_email %></strong>
              </div>
            <% end %>

            <hr class="my-4">

            <h5 class="mb-3">Alterar senha</h5>

            <div class="mb-3">
              <%= f.label :password, "Nova senha", class: "form-label" %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "Deixe em branco se não deseja alterar" %>
              <% if @minimum_password_length %>
                <small class="text-muted d-block mt-1">Mínimo de <%= @minimum_password_length %> caracteres</small>
              <% end %>
            </div>

            <div class="mb-3">
              <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "Repita a nova senha" %>
            </div>

            <hr class="my-4">

            <div class="mb-4">
              <%= f.label :current_password, "Senha atual", class: "form-label" %>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "form-control", placeholder: "Digite sua senha atual para confirmar as mudanças" %>
              <small class="text-muted d-block mt-1">Precisamos de sua senha atual para confirmar as alterações</small>
            </div>

            <div class="d-grid gap-2 mb-3">
              <%= f.submit "Salvar alterações", class: "btn btn-primary" %>
            </div>
          <% end %>

          <hr class="my-4">

          <div class="alert alert-danger-light border-danger-subtle mb-0">
            <h5 class="small mb-2 text-danger"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Zona de perigo</h5>
            <p class="small text-muted mb-2">Ao cancelar sua conta, todos os seus dados serão permanentemente deletados.</p>
            <%= button_to "Cancelar minha conta", registration_path(resource_name), data: { confirm: "Tem certeza? Essa ação não pode ser desfeita.", turbo_confirm: "Tem certeza? Essa ação não pode ser desfeita." }, method: :delete, class: "btn btn-sm btn-outline-danger" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

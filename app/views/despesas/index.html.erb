<% content_for :title, "Despesas — #{@republica.name}" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
      <p class="text-muted small mb-1"><%= link_to @republica.name, republica_path(@republica), class: "link-secondary" %></p>
      <h1 class="h3 mb-0">Despesas</h1>
    </div>
    <%= link_to "Nova despesa", new_republica_despesa_path(@republica), class: "btn btn-success" %>
  </div>

  <% if @despesas.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Descrição</th>
            <th>Categoria</th>
            <th>Vencimento</th>
            <th class="text-end">Valor</th>
            <th class="text-end">Por morador</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @despesas.each do |despesa| %>
            <tr>
              <td><%= link_to despesa.descricao, republica_despesa_path(@republica, despesa), class: "link-dark" %></td>
              <td><span class="badge text-bg-secondary"><%= despesa.categoria_label %></span></td>
              <td><%= despesa.vencimento.strftime("%d/%m/%Y") %></td>
              <td class="text-end"><%= number_to_currency(despesa.valor) %></td>
              <td class="text-end">
                <% if despesa.valor_por_morador %>
                  <%= number_to_currency(despesa.valor_por_morador) %>
                <% else %>
                  <span class="text-muted small">sem moradores ativos</span>
                <% end %>
              </td>
              <td class="text-end text-nowrap">
                <%= link_to "Editar", edit_republica_despesa_path(@republica, despesa), class: "btn btn-outline-primary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info mb-0">
      Nenhuma despesa cadastrada.
      <%= link_to "Cadastrar a primeira", new_republica_despesa_path(@republica), class: "alert-link" %>.
    </div>
  <% end %>

  <p class="mt-4 mb-0">
    <%= link_to "← Voltar à república", republica_path(@republica), class: "link-secondary" %>
  </p>
</div>

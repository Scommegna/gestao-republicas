<%= form_with model: [ @republica, @despesa ], class: "row g-3" do |form| %>
  <% if @despesa.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger">
        <p class="mb-1 fw-semibold"><%= pluralize(@despesa.errors.count, "erro") %> impediram o salvamento:</p>
        <ul class="mb-0">
          <% @despesa.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="col-12">
    <%= form.label :descricao, "Descrição", class: "form-label" %>
    <%= form.text_field :descricao, class: "form-control", required: true %>
  </div>

  <div class="col-md-6">
    <%= form.label :valor, "Valor (R$)", class: "form-label" %>
    <%= form.number_field :valor, class: "form-control", step: "0.01", min: "0.01", required: true %>
  </div>

  <div class="col-md-6">
    <%= form.label :vencimento, "Vencimento", class: "form-label" %>
    <%= form.date_field :vencimento, class: "form-control", required: true %>
  </div>

  <div class="col-12">
    <%= form.label :categoria, "Categoria", class: "form-label" %>
    <%= form.select :categoria,
          options_for_select(
            Despesa::CATEGORIAS.map { |c| [ Despesa::CATEGORIA_LABELS[c], c ] },
            @despesa.categoria
          ),
          { include_blank: "Selecione…" },
          class: "form-select",
          required: true %>
  </div>

  <% if @republica.residents.active.any? %>
    <div class="col-12">
      <label class="form-label d-block">Moradores a incluir</label>
      <% if @republica.residents.active.count <= 5 %>
        <% @republica.residents.active.each do |resident| %>
          <div class="form-check">
            <%= form.check_box :resident_ids, { multiple: true, class: "form-check-input" }, resident.id, nil %>
            <%= form.label "despesa_resident_ids_#{resident.id}", resident.name, class: "form-check-label" %>
          </div>
        <% end %>
      <% else %>
        <%= form.collection_check_boxes :resident_ids, @republica.residents.active, :id, :name do |b| %>
          <div class="form-check">
            <%= b.check_box(class: "form-check-input") %>
            <%= b.label(class: "form-check-label") %>
          </div>
        <% end %>
      <% end %>
      <small class="text-muted d-block mt-2">Se nenhum morador for selecionado, a despesa será dividida entre todos os ativos.</small>
    </div>
  <% end %>

  <div class="col-12 d-flex gap-2">
    <%= form.submit class: "btn btn-success" %>
    <%= link_to "Cancelar", republica_despesas_path(@republica), class: "btn btn-outline-secondary" %>
  </div>
<% end %>

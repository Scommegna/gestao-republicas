<% content_for :title, @despesa.descricao %>

<div class="container py-4">
  <p class="text-muted small mb-1">
    <%= link_to @republica.name, republica_path(@republica), class: "link-secondary" %> /
    <%= link_to "Despesas", republica_despesas_path(@republica), class: "link-secondary" %>
  </p>

  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <h1 class="h3 mb-0"><%= @despesa.descricao %></h1>
    <div class="btn-group">
      <%= link_to "Editar", edit_republica_despesa_path(@republica, @despesa), class: "btn btn-outline-primary btn-sm" %>
      <%= button_to "Excluir", republica_despesa_path(@republica, @despesa), method: :delete, class: "btn btn-outline-danger btn-sm",
            form: { data: { turbo_confirm: "Excluir esta despesa?" } } %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-4">Categoria</dt>
        <dd class="col-sm-8"><%= @despesa.categoria_label %></dd>

        <dt class="col-sm-4">Valor total</dt>
        <dd class="col-sm-8"><%= number_to_currency(@despesa.valor) %></dd>

        <dt class="col-sm-4">Vencimento</dt>
        <dd class="col-sm-8"><%= @despesa.vencimento.strftime("%d/%m/%Y") %></dd>

        <dt class="col-sm-4">Valor por morador</dt>
        <dd class="col-sm-8">
          <% if @despesa.valor_efetivo_por_morador %>
            <%= number_to_currency(@despesa.valor_efetivo_por_morador) %>
            <span class="text-muted small">(<%= @despesa.moradores_na_despesa %> morador(es))</span>
          <% else %>
            <span class="text-muted">Cadastre moradores para calcular a divisão.</span>
          <% end %>
        </dd>
      </dl>
    </div>
  </div>

  <% if @despesa.pagamentos.any? %>
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Divisão entre moradores</h5>
      </div>
      <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead class="table-light">
            <tr>
              <th>Morador</th>
              <th>Valor</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% @despesa.pagamentos.includes(:resident).order("residents.name").each do |pagamento| %>
              <tr>
                <td><%= pagamento.resident.name %></td>
                <td><%= number_to_currency(pagamento.valor) %></td>
                <td>
                  <% if pagamento.paid? %>
                    <span class="badge bg-success">Pago</span>
                  <% else %>
                    <span class="badge bg-warning">Pendente</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <p class="mt-4 mb-0">
    <%= link_to "← Lista de despesas", republica_despesas_path(@republica), class: "link-secondary" %>
  </p>
</div>

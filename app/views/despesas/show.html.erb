<% content_for :title, @despesa.descricao %>

<div class="container py-4">
  <p class="text-muted small mb-1">
    <%= link_to @republica.name, republica_path(@republica), class: "link-secondary" %> /
    <%= link_to "Despesas", republica_despesas_path(@republica), class: "link-secondary" %>
  </p>

  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <h1 class="h3 mb-0"><%= @despesa.descricao %></h1>
    <div class="btn-group">
      <%= link_to "Editar", edit_republica_despesa_path(@republica, @despesa), class: "btn btn-outline-primary btn-sm" %>
      <%= button_to "Excluir", republica_despesa_path(@republica, @despesa), method: :delete, class: "btn btn-outline-danger btn-sm",
            form: { data: { turbo_confirm: "Excluir esta despesa?" } } %>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-4">Categoria</dt>
        <dd class="col-sm-8"><%= @despesa.categoria_label %></dd>

        <dt class="col-sm-4">Valor total</dt>
        <dd class="col-sm-8"><%= number_to_currency(@despesa.valor) %></dd>

        <dt class="col-sm-4">Vencimento</dt>
        <dd class="col-sm-8"><%= @despesa.vencimento.strftime("%d/%m/%Y") %></dd>

        <dt class="col-sm-4">Valor por morador ativo</dt>
        <dd class="col-sm-8">
          <% if @despesa.valor_por_morador %>
            <%= number_to_currency(@despesa.valor_por_morador) %>
            <span class="text-muted small">(<%= @republica.residents.active.count %> morador(es))</span>
          <% else %>
            <span class="text-muted">Cadastre moradores ativos para calcular a divisão.</span>
          <% end %>
        </dd>
      </dl>
    </div>
  </div>

  <% divisao = @despesa.divisao_por_morador %>
  <div class="card mt-4">
    <div class="card-header bg-transparent">
      <h2 class="h5 mb-0"><i class="bi bi-pie-chart me-2" aria-hidden="true"></i>Divisão entre moradores</h2>
    </div>
    <div class="card-body">
      <% if divisao.any? %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Morador</th>
                <th class="text-end">Cota</th>
                <th class="text-end">Pago</th>
                <th class="text-end">Falta</th>
                <th class="text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% divisao.each do |morador, cota| %>
                <% pago = @despesa.valor_pago_por(morador) %>
                <% falta = [ cota - pago, 0.to_d ].max %>
                <tr>
                  <td><%= morador.name %></td>
                  <td class="text-end"><%= number_to_currency(cota) %></td>
                  <td class="text-end"><%= number_to_currency(pago) %></td>
                  <td class="text-end"><%= number_to_currency(falta) %></td>
                  <td class="text-center">
                    <% if falta.zero? %>
                      <span class="badge text-bg-success">Quitado</span>
                    <% elsif pago.positive? %>
                      <span class="badge text-bg-warning">Parcial</span>
                    <% else %>
                      <span class="badge text-bg-secondary">Em aberto</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr class="fw-semibold border-top">
                <td>Total</td>
                <td class="text-end"><%= number_to_currency(divisao.sum { |_, cota| cota }) %></td>
                <td colspan="3"></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p class="text-muted small mb-0 mt-2">
          A soma das cotas fecha exatamente com o valor total da despesa.
        </p>
      <% else %>
        <p class="text-muted mb-0">
          Nenhum morador ativo cadastrado — cadastre moradores para calcular a divisão.
        </p>
      <% end %>
    </div>
  </div>

  <p class="mt-4 mb-0">
    <%= link_to "← Lista de despesas", republica_despesas_path(@republica), class: "link-secondary" %>
  </p>
</div>
